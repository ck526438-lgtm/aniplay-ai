# Copier vers .env puis adapter
ANIPLAY_HOST=0.0.0.0
ANIPLAY_PORT=8000
ANIPLAY_LOG_LEVEL=info

# AniSkip
ANIPLAY_ANISKIP_BASE_URL=https://api.aniskip.com/v2
ANIPLAY_ANISKIP_TIMEOUT=6.0
ANIPLAY_ANISKIP_CACHE_TTL=21600

# Détection locale
ANIPLAY_ENABLE_LOCAL_FALLBACK=true
ANIPLAY_MEDIA_ROOT=./data
ANIPLAY_OP_SEARCH_WINDOW=360
ANIPLAY_ED_SEARCH_WINDOW=360
ANIPLAY_MIN_SEGMENT_SECONDS=45

# Sous-titres IA (nécessite : pip install -r requirements-subtitles.txt)
ANIPLAY_WHISPER_MODEL=base       # tiny | base | small | medium | large-v3
ANIPLAY_TRANSLATOR=opus          # opus = rapide sur CPU | nllb = toutes les langues, lent
ANIPLAY_WHISPER_DEVICE=auto        # auto | cpu | cuda
ANIPLAY_NLLB_MODEL=facebook/nllb-200-distilled-600M
ANIPLAY_SUBTITLES_DIR=./cache/subtitles
ANIPLAY_SUBTITLES_MAX_JOBS=1
# true = lecteur et backend sur le MÊME PC : le backend peut lire n'importe quel
# fichier choisi dans l'app. À mettre à false sur un serveur partagé.
ANIPLAY_LOCAL_MODE=true
ANIPLAY_ALLOW_REMOTE_MEDIA=true

# CORS (séparés par des virgules ; * en dev)
ANIPLAY_CORS_ORIGINS=*
