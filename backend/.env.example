# Copier vers .env puis adapter
ANIPLAY_HOST=0.0.0.0
ANIPLAY_PORT=8000
ANIPLAY_LOG_LEVEL=info

# AniSkip
ANIPLAY_ANISKIP_BASE_URL=https://api.aniskip.com/v2
ANIPLAY_ANISKIP_TIMEOUT=6.0
ANIPLAY_ANISKIP_CACHE_TTL=21600

# Détection locale
ANIPLAY_ENABLE_LOCAL_FALLBACK=true
ANIPLAY_MEDIA_ROOT=./data
ANIPLAY_OP_SEARCH_WINDOW=360
ANIPLAY_ED_SEARCH_WINDOW=360
ANIPLAY_MIN_SEGMENT_SECONDS=45

# CORS (séparés par des virgules ; * en dev)
ANIPLAY_CORS_ORIGINS=*
